# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
*.local

# Vite / tooling caches
.vite/
coverage/
*.tsbuildinfo

# Local editor configuration. Machine-specific and of no use to anyone cloning.
.vscode/
.idea/
*.swp

# Environment files. This project has no server and needs no secrets, but an
# ignore rule costs nothing and prevents a careless commit later.
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS cruft
.DS_Store
Thumbs.db
desktop.ini
